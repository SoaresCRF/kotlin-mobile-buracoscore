    <!-- Regras por tipo de jogo -->
    <!-- Aberto -->
    <string name="rule_open_canasta_1">• Sem jokers.</string>
    <string name="rule_open_canasta_2">• Só sequências (Sem trincas).</string>
    <string name="rule_open_canasta_3">• É necessário canastra limpa para bater.</string>
    <string name="rule_open_canasta_4">• Sequência de Ás a Ás é permitida.</string>
    <string name="rule_open_canasta_5">• É possível bater descartando uma carta ou colocando-a em um jogo.</string>
    <string name="rule_open_canasta_6">• Lixo aberto.</string>

    <!-- Aberto Sujo -->
    <string name="rule_open_dirty_canasta_1">• Com jokers.</string>
    <string name="rule_open_dirty_canasta_2">• Sequências e trincas (Sem trincas de 2).</string>
    <string name="rule_open_dirty_canasta_3">• É possível bater com canastra suja.</string>
    <string name="rule_open_dirty_canasta_4">• Não é permitido sequência de Ás a Ás (permite-se Ás, 2 …, Q, K, 2/joker).</string>
    <string name="rule_open_dirty_canasta_5">• É necessário descartar uma carta para poder bater.</string>
    <string name="rule_open_dirty_canasta_6">• Lixo aberto.</string>

    <!-- Fechado -->
    <string name="rule_closed_canasta_1">• Com jokers.</string>
    <string name="rule_closed_canasta_2">• Sequências e trincas.</string>
    <string name="rule_closed_canasta_3">• É necessário canastra limpa para bater.</string>
    <string name="rule_closed_canasta_4">• Sequência de Ás a Ás é permitida.</string>
    <string name="rule_closed_canasta_5">• É possível bater descartando uma carta ou colocando-a em um jogo.</string>
    <string name="rule_closed_canasta_6">• Lixo fechado: para pegar as cartas, é obrigatório abrir um jogo com a última.</string>

    <!-- Fechado STBL -->
    <string name="rule_closed_stbl_canasta_1">• Com jokers.</string>
    <string name="rule_closed_stbl_canasta_2">• Só sequências (Sem trincas).</string>
    <string name="rule_closed_stbl_canasta_3">• É necessário canastra limpa para bater.</string>
    <string name="rule_closed_stbl_canasta_4">• Sequência de Ás a Ás é permitida.</string>
    <string name="rule_closed_stbl_canasta_5">• É possível bater descartando uma carta ou colocando-a em um jogo.</string>
    <string name="rule_closed_stbl_canasta_6">• Lixo fechado: abrir jogo com a última para pegar o lixo.</string>

    <!-- Fechado Sujo -->
    <string name="rule_closed_dirty_canasta_1">• Com jokers.</string>
    <string name="rule_closed_dirty_canasta_2">• Sequências e trincas.</string>
    <string name="rule_closed_dirty_canasta_3">• É possível bater com canastra suja.</string>
