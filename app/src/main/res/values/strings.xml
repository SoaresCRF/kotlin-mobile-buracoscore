    <!-- ========== Informações de Pontuação (activity_score_info.xml) ========== -->
    <string name="score_info_header">Como funciona?</string>
    <string name="score_info_add_points">adicionar pontos</string>
    <string name="score_info_remove_points">remover pontos</string>
    <string name="score_info_values_header">valores cartas/canastras</string>

    <!-- Adicionar pontos -->
    <string name="score_info_add_1">• Insira todas as cartas e canastras baixadas na mesa.</string>
    <string name="score_info_add_2">• Use os botões “+” e “−” para ajustar a quantidade.</string>
    <string name="score_info_add_3">• Ative “Morto” se tiver pego a segunda mão.</string>
    <string name="score_info_add_4">• Ative “Batida” se você encerrou a partida.</string>
    <string name="score_info_add_5">• Após o preenchimento, clique em “PRÓXIMO”.</string>

    <!-- Remover pontos -->
    <string name="score_info_remove_1">• Insira todas as cartas que ficaram na mão.</string>
    <string name="score_info_remove_2">• Elas serão descontadas da pontuação.</string>
    <string name="score_info_remove_3">• Use os botões “+” e “−” para ajustar a quantidade.</string>
    <string name="score_info_remove_4">• Ao finalizar, clique em “CALCULAR PONTUAÇÃO”.</string>

