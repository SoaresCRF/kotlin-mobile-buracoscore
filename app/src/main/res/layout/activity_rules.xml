        <TextView
            android:id="@+id/textView24"
            style="@style/TextItem"
            android:text="@string/rule_closed_stbl_canasta_6" />

        <!-- Fechado Sujo -->
        <TextView
            style="@style/TextHeader"
            android:text="@string/header_closed_dirty_canasta" />

        <TextView
            android:id="@+id/textView25"
            style="@style/TextItem"
            android:text="@string/rule_closed_dirty_canasta_1" />

        <TextView
            android:id="@+id/textView26"
            style="@style/TextItem"
