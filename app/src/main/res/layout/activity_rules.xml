            android:text="@string/rule_closed_dirty_canasta_5" />

        <TextView
            android:id="@+id/textView30"
            style="@style/TextItem"
            android:layout_marginBottom="20dp"
            android:text="@string/rule_closed_dirty_canasta_6" />

    </LinearLayout>
</ScrollView>
